+/** Critically damped spring, exact step. st = [value, velocity]. */
+function spring(st: number[], target: number, w: number, dt: number): number {
+  const ex = Math.exp(-w * dt), ch = st[0] - target, tmp = (st[1] + w * ch) * dt;
+  st[1] = (st[1] - w * tmp) * ex;
+  st[0] = target + (ch + tmp) * ex;
+  return st[0];
